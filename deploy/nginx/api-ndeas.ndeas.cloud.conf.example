# Nginx config for backend API (api-ndeas.ndeas.cloud)
# Place in /etc/nginx/sites-available/api-ndeas.ndeas.cloud and symlink to sites-enabled

server {
    listen 80;
    server_name api-ndeas.ndeas.cloud;

    # Redirect http to https (enable when cert installed)
    # return 301 https://$host$request_uri;

    location / {
        # Proxy to gunicorn socket
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header Host $http_host;
        proxy_redirect off;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_pass http://unix:/run/gunicorn/ndeascloud.sock;
    }

    # Optional: increase client body size for large file uploads
    client_max_body_size 20M;
}

# For HTTPS with Let's Encrypt, certbot can modify this automatically.
# Example server block for SSL (after obtaining certs):
