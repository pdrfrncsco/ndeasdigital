# Example environment file for ndeascloud (place at /var/www/ndeasvloud/backend/.env)
# Replace placeholder values with real credentials in production.

# Django secret
DJANGO_SECRET=replace-with-secure-secret

# Debug mode (False in production)
DJANGO_DEBUG=False

# Email / SMTP settings
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-smtp-user@example.com
EMAIL_HOST_PASSWORD=your-smtp-password
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=no-reply@ndeias.cloud

# Optional: comma-separated fallback recipients (admins)
EMAIL_FALLBACK_RECIPIENTS=admin1@example.com,admin2@example.com

# Retry tuning
EMAIL_SEND_MAX_ATTEMPTS=3
EMAIL_SEND_BASE_DELAY=1.0

# Allowed hosts (comma-separated)
ALLOWED_HOSTS=your.domain.example
