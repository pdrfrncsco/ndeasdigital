[Unit]
Description=gunicorn daemon for ndeascloud
After=network.target

[Service]
User=deploy
Group=deploy
WorkingDirectory=/var/www/ndeascloud/backend
EnvironmentFile=/var/www/ndeascloud/backend/.env
# Activate virtualenv path
ExecStart=/var/www/ndeascloud/venv/bin/gunicorn \
    --access-logfile - \
    --workers 3 \
    --bind unix:/run/gunicorn/ndeascloud.sock \
    backend_project.wsgi:application

Restart=on-failure
RestartSec=5s

[Install]
WantedBy=multi-user.target
