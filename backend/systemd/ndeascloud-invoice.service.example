# Example systemd unit for ndeascloud Django backend (invoice/email worker + server)
# Copy this file to /etc/systemd/system/ndeascloud.service and adjust paths.

[Unit]
Description=ndeascloud Django app (gunicorn)
After=network.target

[Service]
Type=simple
User=deploy
Group=deploy
WorkingDirectory=/var/www/ndeascloud/backend
EnvironmentFile=/var/www/ndeascloud/backend/.env
# Example: run gunicorn serving the Django project. Adjust module path and workers.
ExecStart=/var/www/ndeascloud/venv/bin/gunicorn backend_project.wsgi:application \
    --workers 3 --bind 0.0.0.0:8000 --log-level info
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=multi-user.target
